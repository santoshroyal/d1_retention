def _render_markdown_to_html(md_text: str) -> str:
    """Convert the report markdown into a self-contained HTML document for the email body."""
    import markdown

    body_html = markdown.markdown(
        md_text,
        extensions=["tables", "fenced_code", "sane_lists"],
    )

    # Tint the first <h1> as a colored severity pill based on the leading emoji.
    # Gmail strips some <style> rules unpredictably, so the pill uses inline styles.
    def _tint_banner(match: re.Match[str]) -> str:
        inner = match.group(1)
        tint = next(
            (v for k, v in _BANNER_TINTS.items() if k in inner),
            None,
        )
        if tint is None:
            return match.group(0)
        style = (
            "display:block;font-size:15px;font-weight:600;line-height:1.45;"
            "margin:0 0 18px 0;padding:10px 14px;border-radius:4px;"
            f"border-left:4px solid {tint['fg']};background:{tint['bg']};color:{tint['fg']};"
        )
        return f'<div style="{style}">{inner}</div>'

    body_html = re.sub(r"<h1>(.*?)</h1>", _tint_banner, body_html, count=1, flags=re.DOTALL)

    css = (
        "body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;"
        "max-width:760px;margin:24px auto;padding:0 16px;color:#222;line-height:1.55;font-size:14px;}"
        "h1{font-size:17px;font-weight:600;color:#111;margin:0 0 10px 0;}"
        "h2{font-size:14px;font-weight:700;color:#1f2937;text-transform:uppercase;letter-spacing:0.08em;"
        "margin:28px 0 12px 0;padding:6px 12px;background:#eef0f3;border-left:3px solid #1f2937;"
        "border-radius:3px;}"
        "h3{font-size:14px;font-weight:600;color:#111;margin:14px 0 6px 0;}"
        "p{margin:6px 0 10px 0;}"
        "ul{padding-left:20px;margin:6px 0 12px 0;}"
        "li{margin:10px 0;}"
        "li > p{margin:4px 0;}"
        "strong{color:#111;}"
        "table{border-collapse:collapse;margin:12px 0;font-size:13px;}"
        "th,td{border:1px solid #ddd;padding:6px 10px;text-align:left;}"
        "th{background:#f4f4f4;}"
        "code{background:#f4f4f4;padding:1px 4px;border-radius:3px;font-size:13px;}"
        "hr{border:none;border-top:1px solid #eee;margin:20px 0;}"
        "blockquote{border-left:3px solid #ccc;margin:12px 0;padding:4px 12px;color:#555;}"
        "em{color:#666;}"
    )
    return (
        '<!DOCTYPE html><html><head><meta charset="utf-8"><style>'
        f"{css}"
        "</style></head><body>"
        f"{body_html}"
        "</body></html>"
    )


def _send_email(
    config: dict[str, Any],
    *,
    subject: str,
    html_body: str,
    text_body: str,
    recipients: list[str],
    attachment_path: Path | None = None,
) -> None:
    """Send a multipart email via SMTP. Recipients are BCC'd so addresses are not exposed to each other."""
    import smtplib
    from email.message import EmailMessage

    email_cfg = config["email"]
    from_addr = os.environ[email_cfg["from_env_var"]]
    password = os.environ[email_cfg["password_env_var"]].replace(" ", "")
    smtp_host = email_cfg.get("smtp_host", "smtp.gmail.com")
    smtp_port = int(email_cfg.get("smtp_port", 587))

    msg = EmailMessage()
    msg["Subject"] = subject
    msg["From"] = from_addr
    msg["To"] = from_addr  # visible recipient = sender; actual recipients are BCC
    msg["Bcc"] = ", ".join(recipients)
    msg.set_content(text_body)
    msg.add_alternative(html_body, subtype="html")
    if attachment_path is not None and attachment_path.exists():
        msg.add_attachment(
            attachment_path.read_bytes(),
            maintype="text",
            subtype="markdown",
            filename=attachment_path.name,
        )

    with smtplib.SMTP(smtp_host, smtp_port) as smtp:
        smtp.starttls()
        smtp.login(from_addr, password)
        smtp.send_message(msg)


