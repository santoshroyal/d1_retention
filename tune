def _allowed_mcp_tools() -> str:
    """Derive the --allowed-tools list from the live MCP registry.

    Single source of truth: every Python file under tools/ that registers a
    @server.tool() becomes an allowed name automatically. Adding a new tool
    means creating one file; the whitelist follows. Hand-maintained lists
    drift the moment a new tool lands — we burned a v1.3 cycle on exactly
    that bug. The probe imports tune_mcp.py (which transitively imports every
    tool file) and reads back the registered names. Cached at module load.
    """
    import asyncio  # local — only used here
    from importlib.machinery import SourceFileLoader

    mod = SourceFileLoader("_whitelist_probe", str(MCP_SERVER_PATH)).load_module()
    tools = asyncio.run(mod.server.list_tools())
    return " ".join(f"mcp__sandbox__{t.name}" for t in tools)


