def _run_sheet_prefetch(*, force: bool) -> None:
    """Refresh registered sheets before the LLM is invoked.

    Default behaviour: refresh any pre_fetch tab whose last_fetched_at is
    earlier than today's 11:00 IST threshold. With force=True (from
    `./tune --refresh`), every pre_fetch tab is re-fetched regardless of
    timestamp. Failures are non-fatal — a single sheet error becomes a
    warning line and the run continues.
    """
    try:
        from tools._sheet_store import (
            force_refresh_all,
            prefetch_due_sheets,
        )
    except Exception as e:  # noqa: BLE001
        console.print(f"[yellow]⚠ sheet store unavailable: {e}[/yellow]\n")
        return

    started = time.time()
    try:
        results = force_refresh_all() if force else prefetch_due_sheets()
    except Exception as e:  # noqa: BLE001
        console.print(f"[yellow]⚠ sheet pre-fetch failed: {e}[/yellow]\n")
        return

    if not results:
        return

    if force:
        label = "Sheets (forced refresh)"
    else:
        label = "Sheets (daily threshold check)"

    # Per-status visual treatment: glyph + verb shown for every sheet so the PM
    # can see at a glance whether each sheet was newly fetched or read from cache.
    GLYPH_VERB = {
        "fetched":   ("[green]✓[/green]", "fetched"),    # network call this run, content updated
        "no-change": ("[green]✓[/green]", "fetched"),    # network call this run, content identical
        "skipped":   ("[dim]•[/dim]",     "cached"),     # within schedule window, no network call
        "cached":    ("[yellow]⚠[/yellow]", "cached"),   # network failed, fell back to local copy
        "error":     ("[red]✗[/red]",     "error"),      # no cache, network failed — unusable
    }

    console.print(f"[bold]{label}[/bold]")
    name_width = max((len(r["name"]) for r in results), default=20)
    for r in results:
        glyph, verb = GLYPH_VERB.get(r["status"], ("•", r["status"]))
        kb = max(1, r["bytes"] // 1024) if r["bytes"] else 0
        ts = r.get("last_fetched_ist") or "(never)"
        size_part = f"{kb} KB" if kb else "no cache"
        # Detail varies by status. Cached/skipped: just the timestamp. Fetched/no-change:
        # timestamp plus whether content actually changed. Error/cached(fallback): include the error message.
        if r["status"] == "fetched":
            detail = f"fetched at {ts} · content changed"
        elif r["status"] == "no-change":
            detail = f"checked at {ts} · content unchanged"
        elif r["status"] == "skipped":
            detail = f"using cache from {ts}"
        elif r["status"] == "cached":
            detail = f"using cache from {ts} · {r['message']}"
        else:  # error
            detail = r["message"]
        console.print(
            f"  {glyph} {r['name']:<{name_width}}  [dim]{verb}[/dim]  "
            f"[dim]({size_part} · {detail})[/dim]"
        )
    elapsed = time.time() - started
    fetched_count = sum(1 for r in results if r["status"] in {"fetched", "no-change"})
    cached_count = sum(1 for r in results if r["status"] in {"skipped", "cached"})
    summary_bits = []
    if fetched_count:
        summary_bits.append(f"{fetched_count} fetched")
    if cached_count:
        summary_bits.append(f"{cached_count} from cache")
    summary = ", ".join(summary_bits) or "no sheets"
    console.print(f"  [dim]Done in {elapsed:.1f}s · {summary}.[/dim]\n")


def _print_run_summary(result: dict[str, Any]) -> None:
    """Print a one-line summary of tool-call activity after the report renders.

    Visible signal of how many tool calls fired and how many failed. Always
    prints — a `0 total` line is itself diagnostic information (it means the
    event-stream parser missed every tool call, which is a real bug worth
    seeing). The failure count is highlighted in yellow and accompanied by a
    one-line summary per failure when non-zero so the PM cannot scroll past it.
    """
    total = int(result.get("tool_calls_total", 0) or 0)
    failed = int(result.get("tool_calls_failed", 0) or 0)
    stream_errors = int(result.get("stream_parse_errors", 0) or 0)

    if total == 0:
        # Silent stream parse problem — surface it so the next debugging round can chase it.
        suffix = (
            f" · ({stream_errors} stream parse errors swallowed)"
            if stream_errors else " · (counter saw zero events; renderer or stream-shape mismatch likely)"
        )
        console.print(
            f"  [dim]Tool calls:[/dim]  [yellow]0 total{suffix}[/yellow]"
        )
        return

    if failed == 0:
        console.print(
            f"  [dim]Tool calls:[/dim]  [dim]{total} total · all succeeded[/dim]"
        )
    else:
        console.print(
            f"  [dim]Tool calls:[/dim]  [yellow]{total} total · {failed} failed and retried[/yellow]"
        )
        for s in result.get("tool_failure_summaries", []) or []:
            console.print(f"    [yellow]· {s}[/yellow]")
    if stream_errors:
        console.print(
            f"  [dim]Note:[/dim]  [yellow]{stream_errors} stream parse errors were swallowed during the run.[/yellow]"
        )


_PRIMARY_DICT_PATH = PROJECT_ROOT / "data" / "dict" / "app_health_daily.md"
_PRIMARY_DICT_CACHE: str | None = None


def _primary_dictionary() -> str:
    """Read the primary sheet's dictionary, cached per-process.

    Loaded into the user message at preflight so the LLM always has full
    column-level semantics for the primary sheet — including which columns
    are counts vs rates vs derived. Without this in context, the LLM has
    been observed substituting count columns for rate columns when its
    initial column-name guess fails (the d0_uninstall_rate incident).
    """
    global _PRIMARY_DICT_CACHE
    if _PRIMARY_DICT_CACHE is None:
        if _PRIMARY_DICT_PATH.exists():
            _PRIMARY_DICT_CACHE = _PRIMARY_DICT_PATH.read_text(encoding="utf-8")
        else:
            _PRIMARY_DICT_CACHE = ""
    return _PRIMARY_DICT_CACHE


def _validate_report_variant(name: str | None) -> str:
    """Resolve and validate a --report value. Default = 'deep'. Errors if files missing."""
    resolved = (name or "deep").strip().lower()
    if resolved not in VALID_REPORT_VARIANTS:
        _die(
            f"unknown --report value {name!r}.",
            extra=f"  Valid options: {', '.join(VALID_REPORT_VARIANTS)}.",
        )
    needed: list[Path] = []
    if resolved in ("deep", "both"):
        needed.append(DEEP_TEMPLATE_PATH)
    if resolved in ("lite", "both"):
        needed.extend([LITE_TEMPLATE_PATH, LITE_LAYOUT_PATH])
    for p in needed:
        if not p.exists():
            _die(
                f"report template missing: {p.relative_to(PROJECT_ROOT)}.",
                extra="  Run from the project root; reports/ must exist.",
            )
    return resolved


