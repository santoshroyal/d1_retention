            "testing). The daily cron entry should pass --prod."
        ),
    ),
    test_email: str = typer.Option(
        "",
        "--test-email",
        help=(
            "Send a one-shot test email to this address using the configured "
            "SMTP credentials, then exit. Skips the data check and the LLM call."
        ),
    ),
    report: str = typer.Option(
        "lite",
        "--report",
        help=(
            "Which report shape the scheduled run produces. 'lite' (default — "
            "the 4-section metric dashboard, what the daily email expects), "
            "'deep' (the 6-row card + full diagnosis), or 'both'."
        ),
    ),
) -> None:
    """Daily scheduled run — analyse the most recent COMPLETE D1 cohort and email the report.

    Designed to be invoked from cron at 11:05 IST. Targets the install cohort
    from two days ago (today − 2 IST) — that cohort's return day was yesterday,
    so its `d1_corrected` was populated by the upstream pipeline overnight.
    (Yesterday's cohort can't be analysed at 11:05 AM because its return day
    is today, which is not yet complete.)

    If the target cohort's data is still not in the sheet, retries every
    `schedule.retry_interval_minutes` minutes up to `schedule.retry_attempts`
    times. After the last failure, sends a "data unavailable" notice instead
    of the report.
    """
    _load_env_file()
    config = _load_config()
    if test_email:
        _validate_smtp_env(config)
        _send_test_email(config, test_email)
        return
    report_variant = _validate_report_variant(report)
    _validate_schedule_config(config, require_smtp=not dry_run, extended=prod)
    _run_schedule_loop(config, dry_run=dry_run, extended=prod, report_variant=report_variant)


def _load_env_file() -> None:
    """Load PROJECT_ROOT/.env into os.environ if present. Cron does not source shell rc files."""
    env_path = PROJECT_ROOT / ".env"
    if not env_path.exists():
        return
    for line in env_path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip().strip("'\"")
        if key and key not in os.environ:
            os.environ[key] = value


def _validate_smtp_env(config: dict[str, Any]) -> None:
    """Fail fast if the SMTP env vars are missing. Used by both test_email and schedule."""
    email_cfg = config.get("email") or {}
    from_var = email_cfg.get("from_env_var", "TOI_SMTP_FROM")
    pwd_var = email_cfg.get("password_env_var", "TOI_SMTP_APP_PASSWORD")
    if not os.environ.get(from_var):
        _die(
            f"environment variable {from_var} is not set.",
            extra=f"  Copy .env.example to .env and set {from_var}.",
        )
    if not os.environ.get(pwd_var):
        _die(
            f"environment variable {pwd_var} is not set.",
            extra=(
                f"  Generate a Google App Password (Account → Security → "
                f"2-Step Verification → App passwords) and put it in {pwd_var} in .env."
            ),
        )


def _validate_schedule_config(config: dict[str, Any], *, require_smtp: bool, extended: bool = False) -> None:
    """Fail fast if any required schedule or email config piece is missing.

    SMTP env vars are only required when we will actually send email
    (`require_smtp=True`). Dry-run mode passes `require_smtp=False` so the
    flow can be exercised without setting up credentials first.

    `extended=True` validates that the `extended_recipients:` list (used by
    `--prod`) is non-empty. `extended=False` validates the default
    `recipients:` list (used for dev/testing).
    """
    if "schedule" not in config:
        _die("config.yaml is missing the `schedule:` section.")
    if "email" not in config:
        _die("config.yaml is missing the `email:` section.")
    seg = (config.get("schedule") or {}).get("target_segment") or {}
    if "platform" not in seg or "acquisition_source" not in seg:
        _die("config.yaml: schedule.target_segment must define platform and acquisition_source.")
    if require_smtp:
        _validate_smtp_env(config)
    recipients_path = PROJECT_ROOT / "data" / "email_recipients.yaml"
    if not recipients_path.exists():
        _die(
            f"recipients file not found: data/email_recipients.yaml",
            extra="  See data/email_recipients.yaml in the repo for the expected shape.",
        )
    if not _load_recipients(extended=extended):
        key = "extended_recipients" if extended else "recipients"
        _die(
            f"no recipients defined in data/email_recipients.yaml under `{key}:`.",
            extra=f"  Add at least one email address under the `{key}:` key.",
        )


def _load_recipients(*, extended: bool = False) -> list[str]:
    """Read and validate the recipients list. Returns [] when malformed; caller decides what to do.

    `extended=False` (default) reads the `recipients:` key — the small list for
    testing. `extended=True` reads `extended_recipients:` — the full team list
    used by `--prod` and the daily cron entry.
    """
    path = PROJECT_ROOT / "data" / "email_recipients.yaml"
    if not path.exists():
        return []
    try:
        data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    except yaml.YAMLError as e:
        _die(f"data/email_recipients.yaml malformed: {e}")
    key = "extended_recipients" if extended else "recipients"
    raw = data.get(key) or []
    if not isinstance(raw, list):
        _die(f"data/email_recipients.yaml: `{key}` must be a list of strings.")
    return [str(r).strip() for r in raw if str(r).strip()]


def _target_cohort_date():
    """Return the most recent install cohort whose D1 is fully measured.

    `d1_corrected[date X]` requires the full day X+1 to be in the sheet (it
    measures users who installed on X returning on X+1). At an 11:05 AM IST
    run, the only cohort whose D1 was COMPLETE by overnight processing is the
    one from two days ago — its return day (yesterday) is now done.

    Concretely:
      - 11:05 AM May 17 IST → returns May 15 (return day was May 16 = yesterday,
        now complete; d1_corrected[May 15] is populated by the upstream pipeline).
      - 11:05 AM May 18 IST → returns May 16.

    Yesterday's cohort (today − 1) cannot be analysed at 11:05 AM because its
    return day is today, which is not yet complete.
    """
    from datetime import timedelta
    from zoneinfo import ZoneInfo

    now_ist = datetime.now(ZoneInfo("Asia/Kolkata"))
    return now_ist.date() - timedelta(days=2)


def _check_data_present(target_date, config: dict[str, Any]) -> bool:
    """Check if (target_date, platform, source) has non-null d1_corrected in the loaded sheet.

    Assumes the sheet has already been refreshed by the caller (so the in-memory
    cache reflects the latest content). Does NOT trigger a network refresh.
    """
    from tools._common import sheet

    seg = config["schedule"]["target_segment"]
    try:
        df = sheet("app_health_daily")
    except Exception as e:  # noqa: BLE001
        console.print(f"  [yellow]sheet load failed:[/yellow] {type(e).__name__}: {e}")
        return False
    target = pd.to_datetime(target_date)
    rows = df[
        (df["date"] == target)
        & (df["platform"] == seg["platform"])
        & (df["acquisition_source"] == seg["acquisition_source"])
    ]
    if rows.empty:
        return False
    value = rows["d1_corrected"].iloc[0]
    return bool(pd.notna(value))


_BANNER_TINTS = {
    "🔴": {"fg": "#c0392b", "bg": "#fdecea"},  # alert — red
    "🟡": {"fg": "#8a6d0a", "bg": "#fff8d9"},  # flag  — amber
