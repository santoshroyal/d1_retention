def _strip_preamble(report_text: str) -> str:
    """Discard any LLM narration above the report banner.

    The report templates forbid preamble above the severity marker, but the
    LLM occasionally leaks a sentence like "I have all the data needed.
    Writing the lite report now." Scan for the first line containing either
    a severity-badge marker or a markdown heading (`#`); discard every line
    above it. Falls back to the original text if neither marker is found
    (so we never wipe a report that does not match either shape).
    """
    if not report_text.strip():
        return report_text
    badge_re = re.compile(
        r"(🔴\s*ALERT|🟡\s*FLAG|🟢\s*NORMAL|🟡\s*RISE\s*FLAG|🟢\s*RISE\s*ALERT)"
    )
    lines = report_text.splitlines()
    for i, line in enumerate(lines):
        if badge_re.search(line) or line.lstrip().startswith("#"):
            # Preserve the original trailing-newline character if there was one.
            trailing = "\n" if report_text.endswith("\n") else ""
            return "\n".join(lines[i:]) + trailing
    return report_text


def _extract_severity_badge(report_text: str) -> str:
    """Parse the severity badge ('🔴 ALERT', '🟡 FLAG', etc.) from near the top of the report.

    The report template forbids preamble above the banner, but the LLM occasionally
    leaks a "pulling it together" line or a horizontal rule. Scan the first 20
    non-empty lines (after stripping any leading markdown heading markers) for the
    badge pattern, rather than locking onto line 1. The badge always sits near the
    top of any valid report, so 20 lines is a generous safety margin.
    """
    if not report_text.strip():
        return "unknown"
    badge_re = re.compile(
        r"(🔴\s*ALERT|🟡\s*FLAG|🟢\s*NORMAL|🟡\s*RISE\s*FLAG|🟢\s*RISE\s*ALERT)"
    )
    seen = 0
    for line in report_text.splitlines():
        stripped = line.lstrip("#").strip()
        if not stripped:
            continue
        m = badge_re.search(stripped)
        if m:
            return re.sub(r"\s+", " ", m.group(1))
        seen += 1
        if seen >= 20:
            break
    return "unknown"


def _run_scheduled_attempt(
    config: dict[str, Any], target_date, *, report_variant: str = "deep"
) -> Path | None:
    """One scheduled attempt: refresh sheets, check data, run analysis if present.

    Prints the same preflight banner, sheet status, inline report, and run
    summary as `./tune run` so the operator sees a complete trace.

    Returns the report path on success, or None when the target cohort's
    `d1_corrected` is still NaN (the outer retry loop handles re-attempts).
    """
    from tools._common import _SHEET_CACHE

    seg = config["schedule"]["target_segment"]
    query = f"{target_date.strftime('%B %d')} {seg['platform']} {seg['acquisition_source']} D1"

    # 1. Force-refresh every pre_fetch sheet and print the per-sheet status
    #    (same display as `./tune run --refresh`).
    _run_sheet_prefetch(force=True)
    # Clear in-memory DataFrame cache so the next read sees the refreshed file.
    _SHEET_CACHE.clear()

    # 2. Silent data-presence check against the freshly refreshed sheet.
    if not _check_data_present(target_date, config):
        return None

    console.print(f"  [green]✓[/green] data found for {target_date}. Query: {query!r}")

    # 3. Resolve provider + env preflight (same as run()).
    resolved_model, model_display, provider = _resolve_model(None, config)
    _ensure_environment(cli_required=provider)
    prose = PLAYBOOK_PATH.read_text(encoding="utf-8")
    sheet_stats = _compute_sheet_stats()
    user_message = _build_user_message(
        prose=prose, pm_query=query, report_variant=report_variant
    )

    # 4. Print the full preflight banner (playbook, data, extra docs, model,
    #    PM query) — same as the interactive `./tune` flow.
    _print_preflight(
        prose=prose,
        sheet_stats=sheet_stats,
        docs=_list_docs(),
        model_display=model_display,
        pm_query=query,
    )

    # 5. Run the LLM exactly the same way `run()` does.
    output_path = _resolve_output_path(config["output_template"])
    output_path.parent.mkdir(parents=True, exist_ok=True)

    invoke_fn = _invoke_codex if provider == "codex" else _invoke_claude
    spinner_label = "Codex reasoning…" if provider == "codex" else "Claude reasoning…"

    with Progress(
        SpinnerColumn(),
        TextColumn(f"[cyan]{spinner_label}[/cyan]"),
        TimeElapsedColumn(),
        console=console,
        transient=True,
    ) as progress:
        progress.add_task("reasoning", total=None)
        result = invoke_fn(
            system_prompt=config["system_preamble"],
            user_message=user_message,
            model=resolved_model,
            progress=progress,
        )

    result["text"] = _strip_preamble(result["text"])
    output_path.write_text(result["text"], encoding="utf-8")
    _update_latest_symlink(output_path)

    # 6. Render the report inline (same as run() when not quiet).
    console.print()
    console.print(Rule("[bold cyan]Report[/bold cyan]", style="cyan"))
    console.print()
    console.print(Markdown(result["text"]))
    console.print()
    console.print(Rule(style="cyan"))

    # 7. Print the same Done summary lines as run() so the operator sees
    #    cost, tokens, paths, and any stream-parse warnings.
    console.print()
    console.print(
        f"[bold green]✓ Done[/bold green] in {result['duration_ms']/1000:.1f}s "
        f"· ${result['cost_usd']:.4f} "
        f"· {result['input_tokens']:,} in / {result['output_tokens']:,} out tokens"
    )
    console.print(f"  Report:  [cyan]{output_path}[/cyan]")
    console.print(f"  Latest:  [cyan]{OUTPUTS_DIR / 'latest.md'}[/cyan]")
    _print_run_summary(result)
    console.print()

    return output_path


def _send_outcome_email(
    config: dict[str, Any],
    target_date,
    recipients: list[str],
    *,
    status: str,
    body_text: str,
    attachment_path: Path | None,
    body_is_markdown: bool,
) -> None:
    """Compose subject from template + send the final outcome email (success or failure)."""
    subject_template = config["email"].get(
        "subject_template", "<Agentic D1 Report> {platform}  {date} · {status}"
    )
    seg = config["schedule"]["target_segment"]
    subject = subject_template.format(
        date=target_date,
        status=status,
        platform=str(seg["platform"]).title(),
        acquisition_source=seg["acquisition_source"],
    )
    if body_is_markdown:
        html_body = _render_markdown_to_html(body_text)
    else:
        # Plain notice (data unavailable, analysis failed) — render as a simple paragraph.
        escaped = body_text.replace("&", "&amp;").replace("<", "&lt;").replace("\n", "<br>")
        html_body = f"<p>{escaped}</p>"
    _send_email(
        config,
        subject=subject,
        html_body=html_body,
        text_body=body_text,
        recipients=recipients,
        attachment_path=attachment_path,
    )


def _run_schedule_loop(
    config: dict[str, Any],
    *,
    dry_run: bool,
    extended: bool = False,
    report_variant: str = "deep",
) -> None:
    """Outer retry loop. Acquires a lock so two cron firings cannot overlap."""
    import fcntl

    SCHEDULE_LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    SCHEDULE_LOCK_PATH.touch(exist_ok=True)

    sched_cfg = config["schedule"]
    attempts = int(sched_cfg.get("retry_attempts", 5))
    interval_min = int(sched_cfg.get("retry_interval_minutes", 30))
    recipients = _load_recipients(extended=extended)
    target_date = _target_cohort_date()
    seg = sched_cfg["target_segment"]
    list_label = "extended (prod)" if extended else "default (testing)"

    console.print(
        f"[bold]Scheduled run[/bold] · target cohort: {target_date} "
        f"({seg['platform']} / {seg['acquisition_source']}) · report: {report_variant}"
    )
    console.print(f"  retry policy: {attempts} attempts, {interval_min} min apart")
    console.print(f"  recipients [{list_label}] ({len(recipients)}): {', '.join(recipients)}")
    if dry_run:
        console.print("  [yellow]DRY RUN — no email will be sent[/yellow]")

    with SCHEDULE_LOCK_PATH.open("rb") as lf:
        try:
            fcntl.flock(lf, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            console.print(
                "[yellow]Another scheduled run is already in progress (lock held). Exiting.[/yellow]"
            )
            return

        try:
            report_path: Path | None = None
            analysis_error: str | None = None
            for attempt in range(1, attempts + 1):
                console.print(f"\n[bold]Attempt {attempt}/{attempts}[/bold]")
                try:
                    report_path = _run_scheduled_attempt(
                        config, target_date, report_variant=report_variant
                    )
                except Exception as e:  # noqa: BLE001
                    analysis_error = f"{type(e).__name__}: {e}"
                    console.print(f"  [red]analysis failed:[/red] {analysis_error}")
                    break
                if report_path is not None:
                    break
                console.print(f"  [yellow]Data not yet available for {target_date}.[/yellow]")
                if attempt < attempts:
                    # In dry-run, use a tiny sleep so the retry loop is testable
                    # in seconds rather than the configured 30 minutes.
                    sleep_secs = 3 if dry_run else interval_min * 60
                    label = f"{sleep_secs} seconds (dry-run)" if dry_run else f"{interval_min} minutes"
                    console.print(f"  Sleeping {label} before next attempt...")
                    time.sleep(sleep_secs)

            # Outcome dispatch.
            if analysis_error is not None:
                console.print(f"\n[red]Analysis error — sending failure notice.[/red]")
                if dry_run:
                    console.print("[yellow]DRY RUN — skipping email send.[/yellow]")
                    return
                _send_outcome_email(
                    config, target_date, recipients,
                    status="analysis failed",
                    body_text=(
                        f"The scheduled D1 retention analysis for {target_date} "
                        f"({seg['platform']} / {seg['acquisition_source']}) failed.\n\n"
                        f"Error: {analysis_error}"
                    ),
                    attachment_path=None,
                    body_is_markdown=False,
                )
                console.print(f"[green]✓ failure notice sent to {len(recipients)} recipient(s)[/green]")
                return

            if report_path is None:
                console.print(
                    f"\n[red]Data still not available after {attempts} attempts.[/red]"
                )
                if dry_run:
                    console.print("[yellow]DRY RUN — skipping email send.[/yellow]")
                    return
                _send_outcome_email(
                    config, target_date, recipients,
                    status="data unavailable",
                    body_text=(
                        f"D1 data for {target_date} ({seg['platform']} / "
                        f"{seg['acquisition_source']}) was still not in the sheet after "
                        f"{attempts} attempts spaced {interval_min} minutes apart. "
                        f"No analysis was produced.\n\n"
                        f"Please check the upstream pipeline that populates app_health_daily."
                    ),
                    attachment_path=None,
                    body_is_markdown=False,
                )
                console.print(f"[green]✓ data-unavailable notice sent to {len(recipients)} recipient(s)[/green]")
                return

            # Success path.
            console.print("\n[bold green]✓ Analysis succeeded. Preparing email...[/bold green]")
            if dry_run:
                console.print(f"[yellow]DRY RUN — would have emailed {report_path.name} to recipients.[/yellow]")
                return
            report_text = report_path.read_text(encoding="utf-8")
            severity = _extract_severity_badge(report_text)
            _send_outcome_email(
                config, target_date, recipients,
                status=severity,
                body_text=report_text,
                attachment_path=report_path,
                body_is_markdown=True,
            )
            console.print(
                f"[bold green]✓ Email sent to {len(recipients)} recipient(s): {severity}[/bold green]"
            )

        finally:
            fcntl.flock(lf, fcntl.LOCK_UN)


def _run_doctor_checks() -> None:
    """Extended preflight for ./tune doctor — verifies deps, imports, files, CLI.

    The lighter `_ensure_environment` is what runs on every ./tune call. This
    function is heavier but only runs on demand from `doctor`.
    """
    console.print("[bold]Environment[/bold]")

    # 1. Python version (we use 3.11+ syntax: tuple[str, ...] | None, etc.)
    py = sys.version_info
    if py < (3, 11):
        _die(f"Python ≥ 3.11 required (have {py.major}.{py.minor}.{py.micro})")
    console.print(f"  [green]✓[/green] Python {py.major}.{py.minor}.{py.micro}")

    # 2. uv on PATH (the shebang relies on it).
    if shutil.which("uv") is None:
        _die("`uv` not found on PATH. Install: https://docs.astral.sh/uv/")
    console.print("  [green]✓[/green] uv present on PATH")

    # 3. Python dependencies importable (with versions).
    import importlib.metadata as _md

    deps = ("mcp", "PyYAML", "pandas", "rich", "typer", "openpyxl", "tabulate")
    for spec in deps:
        try:
            ver = _md.version(spec)
            console.print(f"  [green]✓[/green] {spec} {ver}")
        except _md.PackageNotFoundError:
            _die(f"{spec} not installed in this venv. Run: uv sync")

    # 4. MCP server smoke-imports cleanly (no syntax errors, no dep failures).
    if not MCP_SERVER_PATH.exists():
        _die(f"MCP server file missing: {MCP_SERVER_PATH}")
    try:
        from importlib.machinery import SourceFileLoader

        SourceFileLoader("_tune_mcp_doctor", str(MCP_SERVER_PATH)).load_module()
        console.print(f"  [green]✓[/green] {MCP_SERVER_PATH.name} imports cleanly")
    except Exception as e:
        _die(f"{MCP_SERVER_PATH.name} failed to import: {type(e).__name__}: {e}")

    # 5. config.yaml parses and has required keys.
    console.print("[bold]Project files[/bold]")
    if not CONFIG_PATH.exists():
        _die(f"config not found: {CONFIG_PATH}")
    try:
        cfg = yaml.safe_load(CONFIG_PATH.read_text(encoding="utf-8"))
    except yaml.YAMLError as e:
        _die(f"config.yaml malformed: {e}")
    if not isinstance(cfg, dict):
        _die("config.yaml does not contain a top-level mapping")
    required = {"model", "system_preamble", "output_template"}
    missing = required - set(cfg.keys())
    if missing:
        _die(f"config.yaml missing keys: {sorted(missing)}")
    console.print(
        f"  [green]✓[/green] config.yaml parses; model={cfg['model']}"
    )

    # 6. Playbook present.
    if not PLAYBOOK_PATH.exists():
        _die(f"playbook not found: {PLAYBOOK_PATH}")
    word_count = len(PLAYBOOK_PATH.read_text(encoding="utf-8").split())
    console.print(
        f"  [green]✓[/green] playbook present: {PLAYBOOK_PATH.name} "
        f"({word_count:,} words)"
    )

    # 7. Sheet present.
    if not SHEET_PATH.exists():
        _die(
            f"sheet not found: {SHEET_PATH}\n"
            "  An engineer drops the source CSV into data/sheets/ once."
        )
    rows = max(0, sum(1 for _ in SHEET_PATH.open()) - 1)
    console.print(
        f"  [green]✓[/green] sheet present: {SHEET_PATH.name} ({rows:,} rows)"
    )

    # 7b. Sheet registry parses; each tab's URL synthesizes; cache dir is writable.
    try:
        from tools._sheet_store import (
            CACHE_DIR,
            registry_summary,
            synthesize_url,
        )
    except Exception as e:  # noqa: BLE001
        _die(f"tools/_sheet_store.py failed to import: {type(e).__name__}: {e}")
    try:
        summary = registry_summary()
    except Exception as e:  # noqa: BLE001
        _die(f"data/sheets/_registry.yaml failed to parse: {type(e).__name__}: {e}")
    console.print(
        f"  [green]✓[/green] sheet registry parses; {summary['tab_count']} tab(s) registered: "
        f"{', '.join(summary['tab_names'])}"
    )
    bad_url = []
    for name in summary["tab_names"]:
        try:
            synthesize_url(name)
        except Exception as e:  # noqa: BLE001
            bad_url.append(f"{name}: {e}")
    if bad_url:
        _die(f"tab URL synthesis failed: {bad_url}")
    console.print("  [green]✓[/green] all tab URLs synthesize cleanly")
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    if not os.access(CACHE_DIR, os.W_OK):
        _die(f"sheet cache dir not writable: {CACHE_DIR}")
    console.print(
        f"  [green]✓[/green] sheet cache writable: {CACHE_DIR.relative_to(PROJECT_ROOT)}"
    )
    console.print(
        f"  [green]✓[/green] daily threshold = {summary['threshold_ist']} IST "
        f"(latest passed = {summary['threshold_utc']})"
    )

    # 7c. Each registered sheet's dictionary file exists on disk.
    from tools._sheet_store import _load_registry
    reg = _load_registry()
    missing_dicts: list[str] = []
    for sheet_name, entry in reg["tabs"].items():
        dict_rel = entry.get("dictionary")
        if not dict_rel:
            continue
        dict_path = PROJECT_ROOT / "data" / dict_rel
        if not dict_path.exists():
            missing_dicts.append(f"{sheet_name} → data/{dict_rel}")
    if missing_dicts:
        _die(
            "registered sheets reference dictionary files that do not exist:\n  "
            + "\n  ".join(missing_dicts)
        )
    dict_dir = PROJECT_ROOT / "data" / "dict"
    if dict_dir.exists():
        dict_count = len([p for p in dict_dir.glob("*.md") if p.is_file()])
        console.print(
            f"  [green]✓[/green] data/dict/ present ({dict_count} sheet dictionar"
            f"{'y' if dict_count == 1 else 'ies'})"
        )

    # 8. data/docs/ folder.
    docs_dir = PROJECT_ROOT / "data" / "docs"
    if not docs_dir.exists():
        _die(f"missing folder: {docs_dir}")
    docs = _list_docs()
    docs_label = ", ".join(docs) if docs else "empty"
    console.print(
        f"  [green]✓[/green] data/docs/ present ({len(docs)} files): {docs_label}"
    )

    # 9. outputs/ writable (create if absent).
    OUTPUTS_DIR.mkdir(parents=True, exist_ok=True)
    if not os.access(OUTPUTS_DIR, os.W_OK):
        _die(f"outputs/ not writable: {OUTPUTS_DIR}")
    console.print(f"  [green]✓[/green] outputs/ writable")

    # 10. LLM CLIs on PATH. Either claude OR codex is enough; doctor reports
    # on both so the PM knows which providers are available.
    console.print("[bold]External tools[/bold]")
    any_cli = False
    for binary, install_hint in (
        ("claude", "Install Claude Code (https://claude.com/code) and run `claude` once to log in."),
        ("codex", "Install OpenAI Codex CLI and run `codex login` once."),
    ):
        if shutil.which(binary) is None:
            console.print(f"  [yellow]✗[/yellow] {binary} CLI not on PATH ({install_hint})")
            continue
        any_cli = True
        try:
            proc = subprocess.run(
                [binary, "--version"], capture_output=True, text=True, timeout=10
            )
            version_line = (proc.stdout.strip() or proc.stderr.strip()).splitlines()[0]
            console.print(f"  [green]✓[/green] {binary} CLI: {version_line}")
        except (subprocess.TimeoutExpired, FileNotFoundError, IndexError):
            console.print(f"  [green]✓[/green] {binary} CLI present on PATH")
    if not any_cli:
        _die("Neither `claude` nor `codex` CLI is on PATH. At least one is required.")

    console.print(
        "[dim]  Note: doctor cannot verify whether `claude` is logged in. "
        "If a real run fails with an auth error, run `claude` interactively once.[/dim]"
    )


def _run_verify_checks() -> None:
    """Validate the playbook's tool calls against the live MCP registry.

    Two layers of checking:
      1. Imports `tune_mcp.py`, which transitively imports every tool file in
         `tools/`. Catches Python errors (syntax errors, missing imports, etc.)
         in any tool file before the PM pays for an LLM run.
      2. Parses the playbook prose for tool-call patterns and validates each
         against the live tool registry: tool name exists, named parameters
         match the tool's input schema.

    Exits 0 on success, non-zero with a clear error otherwise.
    """
    import asyncio
    import difflib
    import re as _re

    console.print("[bold]Verify[/bold]")

    # --- Layer 1: import the MCP server (transitively imports every tool) ---
    try:
        from importlib.machinery import SourceFileLoader

        mcp_module = SourceFileLoader(
            "_verify_mcp_srv", str(MCP_SERVER_PATH)
        ).load_module()
    except Exception as e:
        _die(
            f"failed to import the MCP server:\n  "
            f"{type(e).__name__}: {e}\n  "
            f"This usually means a tool file under tools/ has a Python error."
        )
    console.print(f"  [green]✓[/green] {MCP_SERVER_PATH.name} imports cleanly")

    async def _list_tools_async():
        return await mcp_module.server.list_tools()

    tools = asyncio.run(_list_tools_async())
    tool_index: dict[str, dict[str, Any]] = {}
    for t in tools:
        tool_index[t.name] = {
            "description": t.description or "",
            "schema": t.inputSchema or {},
        }
    console.print(f"  [green]✓[/green] {len(tools)} tool(s) registered")

    # --- Layer 2: parse the playbook for tool calls ---
    if not PLAYBOOK_PATH.exists():
        _die(f"playbook not found: {PLAYBOOK_PATH}")

    prose = PLAYBOOK_PATH.read_text(encoding="utf-8")
    lines = prose.splitlines()
    errors: list[str] = []
    call_count = 0

    # Recognise calls like `tool_name(arg1=value1, arg2=value2)`. Tool names
    # must be referenced by name; freeform mentions in prose are only
    # validated when followed by an opening paren (i.e. call sites).
    call_pattern = _re.compile(r"\b([a-z_][a-z0-9_]*)\s*\(", _re.IGNORECASE)

    # Build a flat index from line offsets to line numbers for nicer errors.
    line_starts: list[int] = [0]
    for line in lines:
        line_starts.append(line_starts[-1] + len(line) + 1)

    def _line_for_offset(off: int) -> int:
        # Binary search would be faster but linear is fine for our prose size.
        for i, start in enumerate(line_starts):
            if start > off:
                return i  # 1-based line number
        return len(lines)

    for m in call_pattern.finditer(prose):
        name = m.group(1)
        # Heuristic: only treat as a tool call if name looks like a tool we know
        # OR it starts with one of our common verbs. Otherwise it's likely a
        # natural-language mention or a function in code prose unrelated to
        # tools — skip silently.
        if name not in tool_index:
            # Suggest if it's close to a known name.
            close = difflib.get_close_matches(name, tool_index.keys(), n=1, cutoff=0.7)
            if close:
                line_no = _line_for_offset(m.start())
                errors.append(
                    f"playbook line {line_no}: unknown tool {name!r}. "
                    f"Did you mean {close[0]!r}?"
                )
            # else: not a tool call, ignore.
            continue

        # We've matched a known tool. Now extract the arguments inside (...).
        call_count += 1
        paren_start = m.end() - 1  # position of the '('
        depth = 0
        end = None
        for i in range(paren_start, len(prose)):
            ch = prose[i]
            if ch == "(":
                depth += 1
            elif ch == ")":
                depth -= 1
                if depth == 0:
                    end = i
                    break
        if end is None:
            line_no = _line_for_offset(m.start())
            errors.append(
                f"playbook line {line_no}: unclosed `(` after tool {name!r}"
            )
            continue
        args_text = prose[paren_start + 1 : end]

        # Pull out the arg keywords. We look for `keyword=...` patterns at the
        # top level (not inside nested parens or quotes).
        kw_pattern = _re.compile(r"([a-zA-Z_][a-zA-Z0-9_]*)\s*=", _re.MULTILINE)
        used_kwargs: set[str] = set()
        for km in kw_pattern.finditer(args_text):
            used_kwargs.add(km.group(1))

        schema = tool_index[name]["schema"]
        valid_params = set((schema.get("properties") or {}).keys())
        unknown = used_kwargs - valid_params
        if unknown:
            line_no = _line_for_offset(m.start())
            for u in sorted(unknown):
                close = difflib.get_close_matches(u, valid_params, n=1, cutoff=0.7)
                hint = f" Did you mean {close[0]!r}?" if close else ""
                errors.append(
                    f"playbook line {line_no}: tool {name!r} has no parameter "
                    f"{u!r}.{hint}"
                )

        # Note: we deliberately do NOT enforce that all required parameters
        # are present, because the LLM is the one calling the tool at runtime.
        # The playbook prose is illustrative; the LLM may fill defaults from
        # the description.

    console.print(f"  [green]✓[/green] {call_count} tool call(s) parsed in playbook")

    if errors:
        err_console.print()
        for e in errors:
            err_console.print(f"  [red]✗[/red] {e}")
        err_console.print()
        _die(f"playbook verify failed: {len(errors)} issue(s) found")

    console.print("[bold green]✓ verify: all tool calls valid[/bold green]")


