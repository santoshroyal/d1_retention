# Example environment file for the scheduled `./tune schedule` mode.
# Copy this to `.env` (which is gitignored) and fill in real values.
# Both variables MUST be set for `./tune schedule` to send email.

# The Gmail / Google Workspace address that sends the daily report.
TOI_SMTP_FROM=santosh.kumar1@timesinternet.in

# Google App Password for the address above.
# Generate one at https://myaccount.google.com → Security → 2-Step Verification → App passwords.
# Pick "Mail" → "Other (Custom)" and label it e.g. "TOI daily report".
# Paste the 16-character password here, with or without the spaces Google shows you.
# Note: App Passwords require 2-Step Verification to be enabled first.
TOI_SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
